<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (android:dataExtractionRules). Same policy as backup_rules.xml,
  expressed for both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="seven-monitor.db" />
        <exclude domain="database" path="seven-monitor.db-shm" />
        <exclude domain="database" path="seven-monitor.db-wal" />
        <exclude domain="file" path="datastore/entitlement.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="seven-monitor.db" />
        <exclude domain="database" path="seven-monitor.db-shm" />
        <exclude domain="database" path="seven-monitor.db-wal" />
        <exclude domain="file" path="datastore/entitlement.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
